//что указывать при создании базы в докере
имя контейнера cos_db
порт 5432

Environment variables:
    POSTGRES_PASSWORD: пароль
    POSTGRES_USER: admin         
    POSTGRES_DB: cos_db  


//команды войти в интерфейс PostgreSQL внутри контейнера докер через докер десктоп
psql -U admin -d postgres //вход через админа в базу данных postgres

\l — показать список всех существующих баз данных (чтобы найти вашу cos_db или другую нужную базу).
\dt — показать список таблиц в текущей базе.
\c имя_базы — переключиться на нужную базу данных из списка.
\q — выйти из интерфейса PostgreSQL обратно к знаку #.
